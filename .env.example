# Copy to .env and fill in. Never commit .env.
# Cloudflare Tunnel token (Cloudflare Zero Trust → Networks → Tunnels).
TUNNEL_TOKEN=

# --- Accounts (only with docker-compose.accounts.yml; see docs/ACCOUNTS-OPS.md) ---
# Long random values: e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Keep a copy of this passphrase OFF this machine; without it the backups can't be read.
BACKUP_PASSPHRASE=
BACKUP_HOST_DIR=./db-backups
PUBLIC_ORIGIN=https://megaman.galosengen.dev
# smtp://user:password@smtp.example.com:587 (or smtp://mailpit:1025 with --profile dev-mail).
# Leave empty and sign-up stays off.
MAIL_URL=
MAIL_FROM=Relic Diver <noreply@galosengen.dev>
